{
  "name": "backend",
  "version": "1.0.0",
  "description": "Sistema de detecção de encontros por geolocalização - Spacecom Trainee Tech 2027",
  "main": "dist/app.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:typecheck": "tsc -p tsconfig.test.json --noEmit",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "start": "node dist/app.js",
    "validate": "tsx src/validate.ts"
  },
  "keywords": [
    "spacecom",
    "geolocation",
    "haversine",
    "typescript",
    "encounter-detection"
  ],
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
